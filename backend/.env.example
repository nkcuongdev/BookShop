PORT=5000
MONGO_URI=mongodb://localhost:27017/bookshop?replicaSet=rs0
JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_REFRESH_SECRET=replace_with_a_different_32_byte_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Destructive development seed (never enable in production).
SEED_CONFIRM=
SEED_ADMIN_PASSWORD=12345678
SEED_USER_PASSWORD=12345678
# Shared password for the seeded staff accounts (warehouse/support/content/accounting)
SEED_STAFF_PASSWORD=12345678

# Public URLs used by payment gateways when redirecting back to the app.
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000

# Inventory protection for COD orders awaiting admin confirmation.
COD_PENDING_TTL_MINUTES=1440
MAX_PENDING_COD_PER_USER=3

# Inventory/payment abuse protection for online checkout.
ONLINE_PAYMENT_TTL_MINUTES=15
MAX_PENDING_ONLINE_PER_USER=3
MAX_PAYMENT_ATTEMPTS_PER_ORDER=3
PAYMENT_RETRY_COOLDOWN_SECONDS=30

# Dev keeps online payment testable without real merchant credentials.
# Set PAYMENT_MOCK_ENABLED=false in production.
# NOTE: real credentials win over this flag. If VNPAY_TMN_CODE/HASH_SECRET
# are filled in, payments and refunds go to the real sandbox even with the
# mock enabled; clear them to force the mock path.
PAYMENT_MOCK_ENABLED=true

# Makes mock refunds behave like VNPay: accepted by the gateway but not yet
# settled, so the PROCESSING state and the reconciliation job can be tested
# without real credentials. Leave unset (or false) for instant settlement.
PAYMENT_MOCK_REFUND_PENDING=false
# How many status lookups a pending mock refund stays pending for.
PAYMENT_MOCK_REFUND_SETTLE_AFTER=1

# VNPay sandbox/production credentials.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_REFUND_IP=127.0.0.1
VNPAY_RETURN_URL=http://localhost:5000/api/orders/payment-return/vnpay

# MoMo sandbox/production credentials.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REFUND_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/refund
MOMO_REDIRECT_URL=http://localhost:5000/api/orders/payment-return/momo
MOMO_IPN_URL=http://localhost:5000/api/orders/webhook/momo

# Optional custom webhook endpoints sign: timestamp + "." + raw JSON body.
# Shared secret for the refund/payment webhooks. The signature check fails
# closed: while this is empty EVERY webhook call is rejected, so the refund
# callback does nothing until it is set on both sides.
PAYMENT_WEBHOOK_SECRET=

# Production image storage. Development falls back to backend/data/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bookshop/books

# Extra image origins accepted when pasting a book image URL, comma separated.
# Defaults already allow Cloudinary, Unsplash, Amazon and placeholder.com.
# These are also injected into the CSP img-src directive.
ALLOWED_IMAGE_ORIGINS=

# Shared limiter store (required in production; local development may omit it).
RATE_LIMIT_REDIS_URL=redis://localhost:6379

# Automatically remove raw analytics events after this many days.
ANALYTICS_RETENTION_DAYS=365

# Support ticket SLA. Deadlines skip closed hours so an out-of-hours ticket is
# not born already breaching; set SUPPORT_BUSINESS_HOURS=false for a 24/7 desk.
SUPPORT_BUSINESS_HOURS=true
SUPPORT_HOUR_START=8
SUPPORT_HOUR_END=21
# 1 = Monday … 7 = Sunday (default: Monday–Saturday).
SUPPORT_BUSINESS_DAYS=1,2,3,4,5,6
SUPPORT_TIMEZONE=Asia/Ho_Chi_Minh
# Tickets parked on the customer auto-resolve after this many quiet days.
SUPPORT_WAITING_CUSTOMER_DAYS=7
# Open tickets one customer may hold on a single order.
SUPPORT_MAX_OPEN_TICKETS_PER_ORDER=3

# Account recovery and email verification. Resend uses HTTPS and works on
# hosts that block SMTP (such as Render Free); SMTP remains a fallback.
RESEND_API_KEY=
MAIL_REQUEST_TIMEOUT_MS=8000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=BookShop <no-reply@example.com>

# Abandoned-cart reminders. A cart untouched for CART_REMINDER_IDLE_HOURS gets
# one nudge; CART_REMINDER_SECOND_HOURS sends a follow-up (0 disables it).
# Carts idle longer than CART_REMINDER_MAX_AGE_DAYS are left alone. Reminders
# respect each user's "promotion" notification preference.
CART_REMINDER_ENABLED=true
CART_REMINDER_IDLE_HOURS=6
CART_REMINDER_SECOND_HOURS=72
CART_REMINDER_MAX_AGE_DAYS=30
CART_REMINDER_MAX_PER_TICK=50
CART_REMINDER_MAX_ITEMS=4

# GHN Sandbox only. The gateway is fixed in source so this learning project
# can never create a real Production pickup request.
GHN_SANDBOX_TOKEN=
GHN_SANDBOX_SHOP_ID=
GHN_SANDBOX_FROM_DISTRICT_ID=
GHN_SANDBOX_FROM_WARD_CODE=
GHN_SANDBOX_REQUEST_TIMEOUT_MS=8000
GHN_SANDBOX_SIMULATION_ENABLED=true
GHN_SANDBOX_SIMULATION_STEP_MS=10000
# Configure GHN's callback URL as:
# https://<app-host>/api/shipping/webhooks/ghn
