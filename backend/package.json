{
  "name": "bookshop-backend",
  "version": "1.0.0",
  "description": "BookShop backend API with Express and MongoDB",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "maintenance": "node src/jobs/runMaintenance.js",
    "reconcile:reviews": "node src/jobs/reconcileReviewRatings.js",
    "reconcile:stock": "node src/jobs/reconcileStock.js",
    "backfill:stock-ledger": "node src/jobs/backfillStockLedger.js",
    "backfill:order-cost": "node src/jobs/backfillOrderCostPrice.js",
    "backfill:reserved-stock": "node src/jobs/backfillReservedStock.js",
    "reset:stock-ledger": "node src/jobs/resetStockLedger.js",
