VITE_API_BASE_URL=http://localhost:5000/api
# Extra image hosts added to the img-src CSP in index.html, comma separated.
# Keep in sync with ALLOWED_IMAGE_ORIGINS in backend/.env, otherwise the
# browser blocks an image URL that the API accepted.
VITE_ALLOWED_IMAGE_ORIGINS=
VITE_SITE_URL=http://localhost:5173
VITE_VN_ADMIN_API_URL=https://provinces.open-api.vn/api
VITE_SOCIAL_FACEBOOK_URL=
VITE_SOCIAL_INSTAGRAM_URL=
VITE_SOCIAL_ZALO_URL=
VITE_SOCIAL_YOUTUBE_URL=
